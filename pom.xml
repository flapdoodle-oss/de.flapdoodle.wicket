                <scope>test</scope>
                <version>${jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.websocket</groupId>
                <artifactId>websocket-jakarta-server</artifactId>
                <scope>test</scope>
                <version>${jetty.version}</version>
            </dependency>

            <!-- uncomment if WebSocket support is needed
            <dependency>
                <groupId>org.eclipse.jetty.websocket</groupId>
                <artifactId>websocket-jakarta-server</artifactId>
                <version>${jetty.version}</version>
                <scope>test</scope>
            </dependency>
